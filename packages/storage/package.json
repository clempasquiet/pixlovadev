{
  "name": "@pixlova/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Abstraction du stockage objet privé : pilote S3 compatible et pilote local à URLs signées (développement, tests).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ensure-bucket": "node dist/ensure-bucket.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0"
  }
}
