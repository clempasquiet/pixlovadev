{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/screenshot-upload-response.json",
  "type": "object",
  "required": [
    "upload",
    "expires_at"
  ],
  "properties": {
    "upload": {
      "type": "object",
      "required": [
        "method",
        "url",
        "headers"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "PUT"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "headers": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  },
  "additionalProperties": false
}
