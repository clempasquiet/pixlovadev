{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/asset-url-response.json",
  "type": "object",
  "required": [
    "asset_id",
    "url",
    "expires_at",
    "size_bytes",
    "sha256",
    "range_supported"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "range_supported": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
