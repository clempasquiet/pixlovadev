{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/player-register-request.json",
  "type": "object",
  "required": [
    "installation_id",
    "public_key",
    "capabilities",
    "outputs",
    "machine_fingerprint"
  ],
  "properties": {
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "player_type",
        "app_version",
        "os",
        "architecture",
        "protocol_versions",
        "manifest_schemas",
        "render_schemas",
        "renderer",
        "image_types",
        "video_profiles",
        "max_canvas",
        "max_concurrent_videos",
        "multi_output",
        "screenshot",
        "volume_control",
        "reboot_host",
        "persistent_storage",
        "storage_quota_bytes"
      ],
      "properties": {
        "player_type": {
          "anyOf": [
            {
              "type": "string",
              "const": "native"
            },
            {
              "type": "string",
              "const": "web"
            }
          ]
        },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]{1,64})?$"
        },
        "os": {
          "type": "object",
          "required": [
            "family",
            "version"
          ],
          "properties": {
            "family": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "linux"
                },
                {
                  "type": "string",
                  "const": "windows"
                },
                {
                  "type": "string",
                  "const": "macos"
                },
                {
                  "type": "string",
                  "const": "android"
                },
                {
                  "type": "string",
                  "const": "other"
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "architecture": {
          "anyOf": [
            {
              "type": "string",
              "const": "x86_64"
            },
            {
              "type": "string",
              "const": "aarch64"
            },
            {
              "type": "string",
              "const": "other"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "minItems": 1,
          "maxItems": 8
        },
        "manifest_schemas": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "minItems": 1,
          "maxItems": 8
        },
        "render_schemas": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "minItems": 1,
          "maxItems": 8
        },
        "renderer": {
          "type": "object",
          "required": [
            "engine",
            "version"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "image_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
            "maxLength": 127
          },
          "maxItems": 32
        },
        "video_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "maxItems": 32
        },
        "max_canvas": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32767
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32767
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "max_concurrent_videos": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "multi_output": {
          "anyOf": [
            {
              "type": "string",
              "const": "supported"
            },
            {
              "type": "string",
              "const": "unsupported"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "string",
              "const": "supported"
            },
            {
              "type": "string",
              "const": "unsupported"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "volume_control": {
          "anyOf": [
            {
              "type": "string",
              "const": "supported"
            },
            {
              "type": "string",
              "const": "unsupported"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "reboot_host": {
          "anyOf": [
            {
              "type": "string",
              "const": "supported"
            },
            {
              "type": "string",
              "const": "unsupported"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "persistent_storage": {
          "anyOf": [
            {
              "type": "string",
              "const": "granted"
            },
            {
              "type": "string",
              "const": "denied"
            },
            {
              "type": "string",
              "const": "unsupported"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "storage_quota_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "title": "PlayerCapabilities"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output_key",
          "connector_type",
          "width",
          "height",
          "refresh_hz",
          "connected"
        ],
        "properties": {
          "output_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "connector_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          },
          "refresh_hz": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "machine_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
