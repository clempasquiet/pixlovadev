{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/player-outputs-report.json",
  "type": "object",
  "required": [
    "outputs"
  ],
  "properties": {
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output_key",
          "connector_type",
          "width",
          "height",
          "refresh_hz",
          "connected"
        ],
        "properties": {
          "output_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "connector_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          },
          "refresh_hz": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "additionalProperties": false
}
