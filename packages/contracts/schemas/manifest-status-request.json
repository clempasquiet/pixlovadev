{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/manifest-status-request.json",
  "type": "object",
  "required": [
    "state",
    "observed_at",
    "error_code",
    "detail"
  ],
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "downloading"
        },
        {
          "type": "string",
          "const": "ready"
        },
        {
          "type": "string",
          "const": "applied"
        },
        {
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
