{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/player-event-batch.json",
  "type": "object",
  "required": [
    "events",
    "dropped_count"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "boot_id",
          "seq",
          "observed_at",
          "type",
          "severity",
          "display_id",
          "assignment_generation",
          "payload"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "boot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string",
                "const": "info"
              },
              {
                "type": "string",
                "const": "warning"
              },
              {
                "type": "string",
                "const": "error"
              },
              {
                "type": "string",
                "const": "critical"
              }
            ]
          },
          "display_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "assignment_generation": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "payload": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_]{0,63}$": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "maxProperties": 32
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "dropped_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false,
  "title": "PlayerEventBatch"
}
