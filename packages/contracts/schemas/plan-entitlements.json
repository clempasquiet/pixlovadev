{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/plan-entitlements.json",
  "type": "object",
  "required": [
    "max_users",
    "storage_quota_bytes",
    "features"
  ],
  "properties": {
    "max_users": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "storage_quota_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "features": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "templates"
          }
        ]
      },
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "additionalProperties": false,
  "title": "PlanEntitlements"
}
