{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/player-token-response.json",
  "type": "object",
  "required": [
    "access_token",
    "token_type",
    "expires_at",
    "credential_generation"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "token_type": {
      "type": "string",
      "const": "Bearer"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    }
  },
  "additionalProperties": false
}
