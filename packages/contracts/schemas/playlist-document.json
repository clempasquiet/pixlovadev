{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/playlist-document.json",
  "type": "object",
  "required": [
    "schema_version",
    "transition",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "transition": {
      "anyOf": [
        {
          "type": "string",
          "const": "cut"
        },
        {
          "type": "string",
          "const": "fade"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "content",
          "duration_ms",
          "enabled",
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "content": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "media"
                  },
                  {
                    "type": "string",
                    "const": "composition"
                  }
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "additionalProperties": false
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400000
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 200
    }
  },
  "additionalProperties": false,
  "title": "PlaylistDocument"
}
