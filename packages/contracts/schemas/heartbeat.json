{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/heartbeat.json",
  "type": "object",
  "required": [
    "uptime_seconds",
    "renderer",
    "displays"
  ],
  "properties": {
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "renderer": {
      "anyOf": [
        {
          "type": "string",
          "const": "ok"
        },
        {
          "type": "string",
          "const": "starting"
        },
        {
          "type": "string",
          "const": "degraded"
        },
        {
          "type": "string",
          "const": "error"
        },
        {
          "type": "string",
          "const": "stopped"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "displays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "display_id",
          "assignment_generation",
          "manifest_applied_version",
          "playback"
        ],
        "properties": {
          "display_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "assignment_generation": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "manifest_applied_version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "playback": {
            "anyOf": [
              {
                "type": "string",
                "const": "playing"
              },
              {
                "type": "string",
                "const": "fallback"
              },
              {
                "type": "string",
                "const": "standby"
              },
              {
                "type": "string",
                "const": "error"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 16
    }
  },
  "additionalProperties": false,
  "title": "HeartbeatPayload"
}
