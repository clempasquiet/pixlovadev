{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/player-pair-response.json",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "status",
        "expires_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "player_id",
        "organization_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "paired"
        },
        "player_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  ]
}
