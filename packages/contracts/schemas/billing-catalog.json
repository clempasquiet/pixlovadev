{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/billing-catalog.json",
  "type": "object",
  "required": [
    "environment",
    "indicative",
    "plans",
    "generated_at"
  ],
  "properties": {
    "environment": {
      "anyOf": [
        {
          "type": "string",
          "const": "test"
        },
        {
          "type": "string",
          "const": "live"
        }
      ]
    },
    "indicative": {
      "type": "boolean"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "version",
          "name",
          "fallback",
          "included_display_slots",
          "max_extra_display_slots",
          "entitlements",
          "indicative",
          "prices"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,39}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "fallback": {
            "type": "boolean"
          },
          "included_display_slots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "max_extra_display_slots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "entitlements": {
            "type": "object",
            "required": [
              "max_users",
              "storage_quota_bytes",
              "features"
            ],
            "properties": {
              "max_users": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "storage_quota_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000000
              },
              "features": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "templates"
                    }
                  ]
                },
                "uniqueItems": true,
                "maxItems": 32
              }
            },
            "additionalProperties": false,
            "title": "PlanEntitlements"
          },
          "indicative": {
            "type": "boolean"
          },
          "prices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "interval",
                "currency",
                "base_amount_minor",
                "extra_slot_amount_minor"
              ],
              "properties": {
                "interval": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "month"
                    },
                    {
                      "type": "string",
                      "const": "year"
                    }
                  ]
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[a-z]{3}$"
                },
                "base_amount_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "extra_slot_amount_minor": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "maxItems": 16
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  },
  "additionalProperties": false,
  "title": "BillingCatalog"
}
