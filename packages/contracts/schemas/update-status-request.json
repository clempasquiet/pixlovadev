{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/update-status-request.json",
  "type": "object",
  "required": [
    "version",
    "state",
    "code",
    "detail",
    "observed_at"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "installed"
        },
        {
          "type": "string",
          "const": "promoted"
        },
        {
          "type": "string",
          "const": "rolled_back"
        },
        {
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  },
  "additionalProperties": false,
  "title": "UpdateStatusRequest"
}
