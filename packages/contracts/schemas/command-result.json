{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/command-result.json",
  "type": "object",
  "required": [
    "command_id",
    "status",
    "finished_at",
    "code",
    "detail"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "success"
        },
        {
          "type": "string",
          "const": "failed"
        },
        {
          "type": "string",
          "const": "rejected"
        },
        {
          "type": "string",
          "const": "expired"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "title": "CommandResult"
}
