{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pixlova.com/v1/display.json",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "site_id",
    "name",
    "width",
    "height",
    "orientation",
    "timezone",
    "lifecycle_status",
    "assignment_generation",
    "active_assignment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "orientation": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 90
        },
        {
          "type": "number",
          "const": 180
        },
        {
          "type": "number",
          "const": 270
        }
      ]
    },
    "timezone": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_status": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "inactive"
        },
        {
          "type": "string",
          "const": "archived"
        }
      ]
    },
    "assignment_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "active_assignment": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "id",
            "organization_id",
            "display_id",
            "player_id",
            "player_output_id",
            "generation",
            "started_at",
            "ended_at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "organization_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "display_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "player_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "player_output_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            "started_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
            },
            "ended_at": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "title": "DisplayAssignment"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "title": "Display"
}
