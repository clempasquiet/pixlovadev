{
  "name": "@pixlova/render-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de rendu partagé pixlova (preview, Player Web, renderer natif) : mise en page déterministe, sélection temporelle et rendu DOM.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@pixlova/contracts": "workspace:*",
    "uqr": "0.1.3"
  },
  "files": [
    "dist",
    "fonts.css"
  ]
}
