{
  "name": "@pixlova/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schéma PostgreSQL pixlova, migrations SQL relues et accès aux données sous contexte tenant.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrations:generate": "drizzle-kit generate",
    "migrations:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "files": [
    "dist",
    "migrations",
    "sql"
  ]
}
