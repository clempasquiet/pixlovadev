# Site public pixlova (WEB-001) : fichiers statiques servis par leur propre conteneur, sans
# dépendance au dashboard ni à l’API. Le TLS est terminé en amont (tunnel Cloudflare).
{
	admin off
	auto_https off
	persist_config off
}

:8090 {
	log {
		output stdout
		format json
	}

	root * /srv/site

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Aucun script ni style en ligne ; seuls les attributs style des frises sont admis.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	handle /site-health {
		respond "ok" 200
	}

	# Fichiers nommés par empreinte : cache long. Pages HTML : revalidées à chaque visite.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /brand/*
	header @static Cache-Control "public, max-age=86400"
	@pages not path /assets/* /fonts/* /brand/*
	header @pages Cache-Control "no-cache"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
