{
  "name": "@pixlova/site",
  "version": "0.1.0",
  "private": true,
  "description": "Site public pixlova (WEB-001) : pages statiques générées au build, servies par leur propre conteneur, sans dépendance au dashboard.",
  "type": "module",
  "scripts": {
    "build": "vite build && node build/ssr/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:browser": "vitest run test/browser"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  }
}
