# Développement local (voir docs/dev/LANCER-EN-LOCAL.md). Copier en `.env` ; ne jamais committer `.env`.
DATABASE_URL=postgres://pixlova_app:app_dev@127.0.0.1:5432/pixlova
DATABASE_SYSTEM_URL=postgres://pixlova_system:system_dev@127.0.0.1:5432/pixlova
REDIS_URL=redis://127.0.0.1:6379
# Clé de développement uniquement (32 octets en base64). Générer la sienne :
#   node -e "console.log('dev:' + require('crypto').randomBytes(32).toString('base64'))"
PIXLOVA_DATA_KEYS=dev:REMPLACER_PAR_UNE_CLE_GENEREE
PIXLOVA_APP_BASE_URL=http://localhost:5173
PIXLOVA_ALLOWED_ORIGINS=http://localhost:5173
PIXLOVA_COOKIE_SECURE=false
PIXLOVA_MAILER=console
# Quota d’utilisateurs de développement avant le lot facturation (L08) ; interdit en production.
PIXLOVA_DEV_MAX_USERS=5
PIXLOVA_DEV_DISPLAY_SLOTS=3
# Pour tester la gestion des membres sans activer la MFA ; laisser `true` hors développement.
PIXLOVA_REQUIRE_MFA_FOR_ADMINS=false
