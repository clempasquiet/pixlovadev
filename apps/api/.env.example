# Développement local (voir docs/dev/LANCER-EN-LOCAL.md). Copier en `.env` ; ne jamais committer `.env`.
DATABASE_URL=postgres://pixlova_app:app_dev@127.0.0.1:5432/pixlova
DATABASE_SYSTEM_URL=postgres://pixlova_system:system_dev@127.0.0.1:5432/pixlova
REDIS_URL=redis://127.0.0.1:6379
# Clé de développement uniquement (32 octets en base64). Générer la sienne :
#   node -e "console.log('dev:' + require('crypto').randomBytes(32).toString('base64'))"
PIXLOVA_DATA_KEYS=dev:REMPLACER_PAR_UNE_CLE_GENEREE
PIXLOVA_APP_BASE_URL=http://localhost:5173
PIXLOVA_ALLOWED_ORIGINS=http://localhost:5173
PIXLOVA_COOKIE_SECURE=false
PIXLOVA_MAILER=console
# Quota d’utilisateurs de développement avant le lot facturation (L08) ; interdit en production.
PIXLOVA_DEV_MAX_USERS=5
PIXLOVA_DEV_DISPLAY_SLOTS=3
# Fonctionnalités payantes activées en développement (templates : instanciation des modèles).
PIXLOVA_DEV_FEATURES=templates
# Pour tester la gestion des membres sans activer la MFA ; laisser `true` hors développement.
PIXLOVA_REQUIRE_MFA_FOR_ADMINS=false
# Stockage média (ADR-009) : pilote local de développement, servi par l’API sous /storage.
# Interdit en production (pilote s3). Racine hors du dépôt versionné (`work/` est ignoré).
PIXLOVA_STORAGE_DRIVER=local
PIXLOVA_STORAGE_LOCAL_ROOT=../../work/storage
# Secret HMAC des URLs signées locales (32 octets au moins). Générer le sien :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIXLOVA_STORAGE_LOCAL_SECRET=REMPLACER_PAR_UN_SECRET_GENERE
# Signature des manifests par le worker (ADR-011) : graine Ed25519 de 32 octets en base64url.
# Générer la sienne (ne jamais la versionner) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PIXLOVA_MANIFEST_KEY_ID=manifest-key-dev
PIXLOVA_MANIFEST_SIGNING_KEY=REMPLACER_PAR_UNE_GRAINE_GENEREE
# Commandes distantes (ADR-014) : clé distincte de celle des manifests, même génération.
# Sans elle, les commandes et captures répondent 503 ; le reste de l’API fonctionne.
# PIXLOVA_COMMAND_KEY_ID=command-key-dev
# PIXLOVA_COMMAND_SIGNING_KEY=REMPLACER_PAR_UNE_GRAINE_GENEREE
