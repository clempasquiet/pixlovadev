{
  "name": "@pixlova/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "start:dev": "node --env-file=.env dist/server.js",
    "simulate-player": "node scripts/simulate-player.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@node-rs/argon2": "2.2.1",
    "@pixlova/contracts": "workspace:*",
    "@pixlova/db": "workspace:*",
    "@pixlova/permissions": "workspace:*",
    "@pixlova/scheduling": "workspace:*",
    "@pixlova/storage": "workspace:*",
    "@pixlova/templates": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@pixlova/workers": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "sharp": "0.35.5"
  }
}
