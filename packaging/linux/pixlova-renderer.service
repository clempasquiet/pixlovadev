# Unité utilisateur (systemd --user) de la session kiosk du compte `pixlova` : renderer
# plein écran. Il suit la version en service via le lien versions/active et ne détient
# aucun secret ; seul le socket local de l’agent lui est accessible.
[Unit]
Description=pixlova — renderer du Player natif
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PIXLOVA_AGENT_SOCKET=/var/lib/pixlova/run/agent.sock
Environment=PIXLOVA_BLOBS_DIR=/var/lib/pixlova/cache/blobs
ExecStart=/var/lib/pixlova/versions/active/pixlova-renderer --shell-dir /var/lib/pixlova/versions/active/player-shell
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
